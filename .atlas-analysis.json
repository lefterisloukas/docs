  "keyFeatures": [
    "Item-level text extraction for 10-K, 10-Q, and 8-K filings back to 1993",
    "Company lookup by ticker or CIK with full SEC metadata",
    "Paginated filing discovery with form type and date range filters",
    "Raw and plain-text document retrieval for any filing artifact",
    "Supported form and item-type discovery endpoints",
    "Bearer token authentication with consistent snake_case API conventions"
  ],
  "publicApiSurface": [
    "GET /health",
    "GET /v1/companies/{identifier}",
    "GET /v1/companies/{identifier}/filings",
    "GET /v1/filings/{accession_number}",
    "GET /v1/filings/{accession_number}/documents",
    "GET /v1/filings/{accession_number}/documents/{document_id}",
    "GET /v1/filings/{accession_number}/items",
    "GET /v1/filings/{accession_number}/items/{item_key}",
    "GET /v1/forms/supported",
    "GET /v1/filings/item_types"
  ]
